                    <run lmargin='555' rmargin='555'>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Segoe UI' lmargin='555' rmargin='555'>PY: Previous Year</run>
                    <run lmargin='555' rmargin='555'>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Segoe UI' lmargin='555' rmargin='555'>QTD: Quarter to Date </run>

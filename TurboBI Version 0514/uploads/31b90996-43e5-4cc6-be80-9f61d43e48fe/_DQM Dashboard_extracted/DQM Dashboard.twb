            <run>Æ&#10;&#10;</run>
            <run fontcolor='#bdcb4c' fontname='Segoe UI'>Time Period Information:</run>
            <run lmargin='555' rmargin='555'>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Segoe UI' lmargin='555' rmargin='555'>CM: Current Month</run>
            <run lmargin='555' rmargin='555'>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Segoe UI' lmargin='555' rmargin='555'>CY: Current Year</run>
            <run lmargin='555' rmargin='555'>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Segoe UI' lmargin='555' rmargin='555'>PQ: Previous Quarter</run>
            <run lmargin='555' rmargin='555'>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Segoe UI' lmargin='555' rmargin='555'>PY: Previous Year</run>
            <run lmargin='555' rmargin='555'>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Segoe UI' lmargin='555' rmargin='555'>QTD: Quarter to Date </run>
            <run lmargin='555' rmargin='555'>Æ&#10;&#10;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#bdcb4c' fontname='Segoe UI'>Dashboard Functionality:</run>
            <run lmargin='555' rmargin='555'>Æ&#10;</run>
            <run fontcolor='#252423' fontname='Segoe UI' lmargin='555' rmargin='555'>Click on the &quot;ℹ️&quot; Button: View all instructions and information for this dashboard and click on  &quot;</run>

            <column caption='HCO-HCP-Payer Selection' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;HCO&quot;'>
              <calculation class='tableau' formula='&quot;HCO&quot;' />
            </column>

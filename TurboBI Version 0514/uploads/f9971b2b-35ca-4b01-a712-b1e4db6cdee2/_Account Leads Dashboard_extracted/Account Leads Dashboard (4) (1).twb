              <calculation class='tableau' formula='[Calculation_691584062177619969]+[Calculation_553379856035995671]+[Calculation_553379856039534617]' />
            </column>
            <column caption='trends_tivi_pt' datatype='integer' name='[Calculation_553379856035995671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [PATIENT_AGE] &lt; 17 AND [latest_mpsii_tx_type] = &apos;AVLAYAH&apos; THEN [PATIENT_ID]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='trend_mpsii_patients' datatype='integer' name='[Calculation_553379856039534617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [PATIENT_AGE] &gt;= 17 and [latest_mpsii_tx_type] in (&apos;AVLAYAH&apos;, &apos;ELAPRASE&apos;) THEN [PATIENT_ID]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='trend_elaprase_pt' datatype='integer' name='[Calculation_691584062177619969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [PATIENT_AGE] &lt; 17 AND [latest_mpsii_tx_type] = &apos;ELAPRASE&apos; THEN [PATIENT_ID]&#13;&#10;    END&#13;&#10;)' />

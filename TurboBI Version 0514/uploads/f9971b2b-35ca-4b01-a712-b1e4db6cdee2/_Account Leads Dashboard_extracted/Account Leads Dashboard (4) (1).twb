                <zone forceUpdate='true' h='33889' id='255' type-v2='text' w='30625' x='55438' y='36667'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='10'>Severe</run>
                    <run fontname='Tableau Regular' fontsize='10'>: Patients classified as Severe exhibit higher disease severity, typically requiring more intensive treatment and monitoring.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='10'>Attenuated</run>
                    <run fontname='Tableau Regular' fontsize='10'>: Represents patients with a less severe or more slowly progressing form of the disease, typically requiring comparatively lower clinical intervention.</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='10'>Note: &quot;This is directional only based on defined business rules&quot;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />

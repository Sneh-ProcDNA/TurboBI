          <button action=''>
            <toggle-action>tabdoc:toggle-button-click-action window-id=&quot;{89A28E1F-7B36-49B5-ACFD-EEE3422058D0}&quot; zone-id=&quot;443&quot; zone-ids=[441]</toggle-action>

      <aliases enabled='yes' />
      <column caption='Total Visits' datatype='integer' name='[Calculation_2454532204152823808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Encounter ID])' />
      </column>
      <column caption='Avg Patient per Doctor for each state' datatype='real' name='[Calculation_2454532204155416577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State]: AVG([Patients per Doctor])}' />
      </column>
      <column caption='Metric - reason' datatype='integer' name='[Calculation_2454532204177350658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2 1] = &apos;Cough&apos; THEN [Calculation_2454532204183240708]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Throat soreness&apos; THEN [Calculation_2454532204183240708]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Skin rash&apos; THEN [Calculation_2454532204183240708]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Depression&apos; THEN [Calculation_2454532204183240708]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Patients by Reason' datatype='integer' name='[Calculation_2454532204183240708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Reason for visit]: ([Calculation_2454532204152823808])}' />
      </column>
      <column caption='Date Range' datatype='boolean' name='[Calculation_4522669595947565058]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Date of Visit] &gt;= [Parameters].[Parameter 5] AND [Date of Visit] &lt;= [Parameters].[Parameter 6]' />
      </column>
      <column caption='Total Distinct Patients' datatype='integer' name='[Calculation_979110744769990656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Encounter ID])' />
      </column>
      <column caption='Number of Patients given ICD 10 and Month' datatype='integer' name='[Calculation_979110744786649090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [ICD-10 Code], YEAR([Date of Visit]),MONTH([Date of Visit]): COUNT([Encounter ID])}' />
      </column>

	column 'Sprint Filter Calc' = SWITCH(TRUE(), SELECTEDVALUE('Time'[Value]) = "Current Sprint", 'FINAL_PLC_JIRA_DATA'[Sprint Number] = 'FINAL_PLC_JIRA_DATA'[Max Sprint Number], SELECTEDVALUE('Time'[Value]) = "Previous Sprint", 'FINAL_PLC_JIRA_DATA'[Sprint Number] = 'FINAL_PLC_JIRA_DATA'[Max Sprint Number] - 1, SELECTEDVALUE('Time'[Value]) = "Last 6 Sprints", 'FINAL_PLC_JIRA_DATA'[Sprint Number] >= 'FINAL_PLC_JIRA_DATA'[Max Sprint Number] - 5, SELECTEDVALUE('Time'[Value]) = "Last 12 Sprints", 'FINAL_PLC_JIRA_DATA'[Sprint Number] >= 'FINAL_PLC_JIRA_DATA'[Max Sprint Number] - 11, SELECTEDVALUE('Time'[Value]) = "Last 20 Sprints", 'FINAL_PLC_JIRA_DATA'[Sprint Number] >= 'FINAL_PLC_JIRA_DATA'[Max Sprint Number] - 19, SELECTEDVALUE('Time'[Value]) = "Current YTD", YEAR ('FINAL_PLC_JIRA_DATA'[Sprint End Date]) = YEAR (TODAY() ()), SELECTEDVALUE('Time'[Value]) = "Last Year", YEAR ('FINAL_PLC_JIRA_DATA'[Sprint End Date]) = YEAR (TODAY() ()) - 1, SELECTEDVALUE('Time'[Value]) = "Next 2 Sprints", 'FINAL_PLC_JIRA_DATA'[Sprint Number] > 'FINAL_PLC_JIRA_DATA'[Max Sprint Number] && 'FINAL_PLC_JIRA_DATA'[Sprint Number] <= 'FINAL_PLC_JIRA_DATA'[Max Sprint Number] + 2)
		dataType: boolean
		lineageTag: 2082eab1-3d11-6a65-0bf3-30cdbf5b8dfc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Ticket Type Calc' = SWITCH(TRUE(), SELECTEDVALUE('Ticket Type'[Value]) = "Total", TRUE(), SELECTEDVALUE('Ticket Type'[Value]) = "Rollover", 'FINAL_PLC_JIRA_DATA'[Rollover Flag] = "YES", SELECTEDVALUE('Ticket Type'[Value]) = "Unassigned", ISBLANK ('FINAL_PLC_JIRA_DATA'[Assignee]) || 'FINAL_PLC_JIRA_DATA'[Assignee] = "Not Assigned" || TRIM('FINAL_PLC_JIRA_DATA'[Assignee]) = "", SELECTEDVALUE('Ticket Type'[Value]) = "Assigned", NOT (ISBLANK ('FINAL_PLC_JIRA_DATA'[Assignee]) || 'FINAL_PLC_JIRA_DATA'[Assignee] = "Not Assigned" || TRIM('FINAL_PLC_JIRA_DATA'[Assignee]) = ""))
		dataType: boolean
		lineageTag: 93cc4bea-35d9-0fc2-17d5-8e00a14d2de1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic


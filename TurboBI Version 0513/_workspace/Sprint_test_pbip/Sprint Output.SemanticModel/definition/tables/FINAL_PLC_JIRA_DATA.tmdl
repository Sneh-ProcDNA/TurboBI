	measure 'Sort Calc' = BLANK() /* TODO: translate Tableau formula -- IF [Parameters].[Parameter 8] = 'Summary' THEN (CASE [Parameters].[Parameter 9] WHEN 'Ascending' THEN RANK_UNIQUE(MIN([SUMMARY]),'asc') WHEN 'Descending' THEN RANK_UNIQUE(min([SUMMARY]),'desc') END) ELSEIF [Parameters].[Parameter 8] = 'Status' THEN (CASE [Parameters].[Parameter 9] WHEN 'Ascending' THEN RANK_UNIQUE(min([STATUS]),'asc') WHEN 'Descending' THEN RANK_UNIQUE(min([STATUS]),'desc') END) ELSEIF [Parameters].[Parameter 8] = 'Issue Key' THEN (CASE [Parameters].[Parameter 9] WHEN 'Ascending' THEN RANK_UNIQUE(min([ISSUE_KEY]),'asc') WHEN 'Descending' THEN RANK_UNIQUE(min([ISSUE_KEY]),'desc') END) ELSEIF [Parameters].[Parameter 8] = 'Epic' THEN (CASE [Parameters].[Parameter 9] WHEN 'Ascending' THEN RANK_UNIQUE(min([EPIC]),'asc') WHEN 'Descending' THEN RANK_UNIQUE(min([EPIC]),'desc') END) END */
		lineageTag: c528df80-8798-88f9-502f-c5d65daeb2ec

		annotation SummarizationSetBy = Automatic

